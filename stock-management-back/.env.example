# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Billing (Mercado Pago)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
FRONTEND_URL="http://localhost:5173"
SPA_BASE_URL="http://localhost:5173"
WEBHOOK_BASE_URL="https://xxxxx.ngrok-free.dev"
BILLING_TRIAL_DAYS="7"
BILLING_PACKAGES=[{"id":"30d","label":"30 días","days":30,"price":20000},{"id":"90d","label":"90 días","days":90,"price":54000},{"id":"365d","label":"365 días","days":365,"price":192000}]
