// use prisma-next

enum user_role {
  @@type("pg/text@1")
  owner    = "owner"
  admin    = "admin"
  employee = "employee"
}

enum payment_status {
  @@type("pg/text@1")
  pending   = "pending"
  approved  = "approved"
  rejected  = "rejected"
  cancelled = "cancelled"
}

model Tenant {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  expiresAt     DateTime       @default(now())
  users         User[]
  categories    Category[]
  suppliers     Supplier[]
  locations     Location[]
  products      Product[]
  sales         Sale[]
  paymentOrders PaymentOrder[]
  createdAt     DateTime       @default(now())
  updatedAt     temporal.updatedAt()
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  name                String
  role                user_role
  tenantId            Int
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           temporal.updatedAt()

  @@index([tenantId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()

  @@index([tenantId])
}

model Location {
  id        Int       @id @default(autoincrement())
  name      String
  code      String
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  stock       Int       @default(0)
  minStock    Int       @default(0)
  price       Decimal
  cost        Decimal?
  unit        String?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales       Sale[]
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([locationId])
}

model Sale {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Decimal
  total       Decimal
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([productId])
}

model PaymentOrder {
  id                       Int            @id @default(autoincrement())
  tenantId                 Int
  tenant                   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageId                String
  days                     Int
  amount                   Decimal
  currency                 String
  status                   payment_status
  mercadopagoPreferenceId  String?
  mercadopagoPaymentId     String?
  createdAt                DateTime       @default(now())
  updatedAt                temporal.updatedAt()

  @@index([tenantId])
}
